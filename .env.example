# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
QUOTE_ESTIMATE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Server-side patent lookup service. Change only this base URL when the service moves.
PATENT_SERVICE_BASE_URL=http://192.168.9.180:9098
PATENT_ANALYSIS_UPSTREAM_TIMEOUT_MS=700000

# Filing signature reminder emails (server-side only)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Pat <notifications@your-domain.com>
# Public HTTPS origin used in customer-facing email links. Never use localhost here.
APP_BASE_URL=https://pat.ecinn.com
# Must match Supabase Authentication > Email OTP expiration.
AUTH_INVITE_TTL_SECONDS=3600

# ECI ERP integration (server-side only; never prefix these with NEXT_PUBLIC_)
ERP_BASE_URL=https://erp.example.com
ECI_ERP_APP_ID=your-app-id
ECI_ERP_CORP_SECRET=your-rotated-corp-secret
ECI_ERP_CORP_ID=your-corp-id
ECI_ERP_TIMEOUT_MS=15000
ECI_ERP_INITIAL_PASSWORD=password
# 32-byte key encoded as base64 (for example: openssl rand -base64 32)
ECI_ERP_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key
# Used by Vercel Cron as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-long-random-cron-secret
